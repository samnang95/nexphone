# ==============================================
# NexPhone Web - Environment Configuration Template
# ==============================================
# Flavors available:
#   npm run dev            (VITE/NEXT dev flavor -> local API on port 4000)
#   npm run dev:staging    (Staging flavor -> staging API on port 4001)
#   npm run dev:prod       (Production flavor -> live cloud API)
# ==============================================

NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_APP_TITLE=NexPhone (Dev)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=3000
