{
  "name": "nexphone-api",
  "version": "1.0.0",
  "description": "NexPhone Core Backend API with multi-flavor environment support",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts --flavor=dev",
    "dev:staging": "tsx watch src/index.ts --flavor=staging",
    "dev:prod": "tsx watch src/index.ts --flavor=prod",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts --flavor=prod",
    "start:staging": "tsx src/index.ts --flavor=staging",
    "start:dev": "tsx src/index.ts --flavor=dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest",
    "seed:admin": "tsx src/scripts/seedAdmin.ts"
  },
  "keywords": [
    "nexphone",
    "voip",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
