# ==============================================
# NexPhone API - Environment Configuration Template
# ==============================================
# Flavors available:
#   npm run dev            (FLAVOR=dev, PORT=4000)
#   npm run dev:staging    (FLAVOR=staging, PORT=4001)
#   npm run dev:prod       (FLAVOR=prod, PORT=4000)
# ==============================================

NODE_ENV=development
FLAVOR=dev
APP_ENV=dev
PORT=4000
APP_NAME=NexPhone API (Dev)

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nexphone_dev

# Security & Tokens
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
