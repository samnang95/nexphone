# ==============================================
# NexPhone API Flavor: PRODUCTION (Live Cloud)
# ==============================================
NODE_ENV=production
FLAVOR=prod
APP_ENV=production
PORT=4000
APP_NAME=NexPhone API

# MongoDB Configuration
MONGODB_URI=mongodb+srv://nexphone-cluster.mongodb.net/nexphone_prod?retryWrites=true&w=majority

# Security & Tokens (Provide securely in cloud secrets manager)
JWT_SECRET=change_me_to_a_secure_random_64_char_secret_in_prod
JWT_EXPIRES_IN=1d

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=https://nexphone.io,https://admin.nexphone.io
